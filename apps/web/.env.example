# Supabase dashboard → Project Settings → API → "Data API" tab.
SUPABASE_URL=https://[project-ref].supabase.co

# Project Settings → API → "API Keys" tab → the "Secret" key (Supabase's
# newer naming for what used to be called service_role). NOT the
# Publishable/public key — server-only, bypasses RLS.
# Never expose this to the browser (no NUXT_PUBLIC_ prefix, ever).
SUPABASE_SERVICE_ROLE_KEY=

# Garmin Connect credentials. Only ever used by scripts/garmin-login.ts, run
# once by hand — the app itself reads stored tokens (garmin_tokens table)
# and never touches these again unless the refresh token itself expires.
GARMIN_EMAIL=
GARMIN_PASSWORD=
# Only needed on a login run where Garmin challenges for a code (see the
# script's output); leave unset otherwise.
GARMIN_MFA_CODE=

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically once
# this is set as a project env var — protects the /api/cron/* routes from
# being called by anyone else who finds the URL. Any long random string.
CRON_SECRET=

# Bearer token for /api/mcp — this is what you configure as the custom
# header when adding this as a remote MCP connector (e.g. in Claude's
# settings). Different secret from CRON_SECRET: different caller, different
# trust boundary. Any long random string.
MCP_BEARER_TOKEN=
